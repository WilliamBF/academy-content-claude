{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -z \"${CONTENT_CREATION_PLUGIN_ROOT:-}\" ] && [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && python \"${CLAUDE_PLUGIN_ROOT}/setup.py\" || exit 0'",
            "timeout": 15,
            "statusMessage": "Setting up atlas-academy..."
          },
          {
            "type": "command",
            "command": "bash -c '[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check_update.py\" || exit 0'",
            "timeout": 10,
            "statusMessage": "Checking for plugin updates..."
          }
        ]
      }
    ]
  }
}
